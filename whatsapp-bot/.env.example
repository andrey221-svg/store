# ---- חובה ----
# מפתח API של Claude. יוצרים אותו ב: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# ---- מי רשאי לתת לבוט פקודות ----
# השאר ריק אם הבוט מחובר לוואטסאפ שלך עצמך: תכתוב לו בצ'אט "הודעה לעצמי".
# אם לבוט יש מספר נפרד (סים נוסף / מספר וירטואלי) - כתוב כאן את המספר האישי שלך.
# אפשר כמה מספרים מופרדים בפסיק.
OWNER_NUMBER=

# חיבור עם קוד צימוד במקום סריקת QR (נוח בשרת). כתוב את מספר הבוט, למשל 0501234567
PAIRING_NUMBER=

# ---- מודל ----
# ברירת מחדל: claude-opus-5-5 (הכי חכם). לחיסכון בעלות אפשר: claude-sonnet-5-5
BOT_MODEL=claude-opus-5-5
# low / medium / high - כמה "לחשוב" לפני פעולה
BOT_EFFORT=medium
# כמה צעדים (חיפוש/לחיצה) מותר לבוט לעשות על הודעה אחת
MAX_STEPS_PER_MESSAGE=40
# אחרי כמה שעות בלי הודעות מתחילים שיחה חדשה
SESSION_IDLE_HOURS=6

# ---- מיקום (לתוצאות חיפוש מקומיות) ----
USER_CITY=
USER_COUNTRY=IL
TZ_NAME=Asia/Jerusalem

# ---- דפדפן ----
# false = לראות את חלון הדפדפן בזמן שהבוט עובד (רק במחשב עם מסך)
BROWSER_HEADLESS=true
# דקות שבהן אישור תשלום נשאר בתוקף
APPROVAL_WINDOW_MINUTES=15
